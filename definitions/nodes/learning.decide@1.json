{
  "id": "learning.decide",
  "version": "1",
  "kind": "agent",
  "outcomes": [
    "success"
  ],
  "required_inputs": [
    "feedback",
    "topic"
  ],
  "cost": 0,
  "bounded_cost": false,
  "instruction": "执行 本节点规定的职责，仅使用交付的局部输入和当前授权；不猜测前驱节点名称或全局最新文件。若 input.rules 存在，核对文件实际 SHA256 并读取本次必要规则；恢复时补读缺失内容。明确区分事实、假设、结果与未验证范围。需要用户意图、权限或改变判断的证据时发送 kind=waiting，说明问题、来源、答复映射和恢复条件，不能用 completed 结束未解决事项。必要成果保存为真实文件并返回绝对路径、类型、版本或内容标识；完成实际职责后才报告 success。收到 reply 后沿原 execution_id/attempt 接续，不复制执行。只读查询自身运行/账本以核对授权、预算、在途状态和已认领待办；不直接修改运行状态或派发后继。可将有依据且不阻塞当前验收的发现放入 discoveries，不强造经验或 Skill。默认会话内执行；后台唤起未提供。\n已到当前练习路径上限，说明理解障碍、已试方法和证据，提出改变教学方案/目标的选项并报告 waiting。没有新依据或用户决定，不继续相同练习，不宣布掌握。\n收到明确决定后记录 decision、evidence、next_action；完成仅表示决定已经记录，不表示用户已经掌握或新教学方案已经执行。",
  "io_contract": {
    "version": "1",
    "input": {
      "type": "object",
      "properties": {
        "feedback": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": true,
          "description": "上一轮练习或审阅的反馈。",
          "minProperties": 1
        },
        "topic": {
          "type": "string",
          "pattern": "\\S",
          "description": "本次学习的主题与目标。"
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "pattern": "\\S",
                "description": "非空文字说明或标识"
              },
              "sha256": {
                "type": "string",
                "pattern": "\\S",
                "description": "非空文字说明或标识"
              },
              "status": {
                "type": "string",
                "pattern": "\\S",
                "description": "非空文字说明或标识"
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": true,
            "description": "结构化记录"
          },
          "minItems": 0,
          "description": "需核对并读取的规则文件及内容哈希"
        }
      },
      "required": [
        "feedback",
        "topic"
      ],
      "additionalProperties": false,
      "description": "本节点的局部输入；不读取其他节点的隐含状态"
    },
    "outputs": {
      "success": {
        "type": "object",
        "properties": {
          "decision": {
            "type": "string",
            "pattern": "\\S",
            "description": "用户对继续、调整或停止学习的明确决定。"
          },
          "evidence": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "\\S",
                  "description": "非空文字说明或标识"
                },
                {
                  "type": "object",
                  "properties": {},
                  "required": [],
                  "additionalProperties": true,
                  "description": "结构化记录",
                  "minProperties": 1
                }
              ],
              "description": "文字说明或具名的结构化内容；其业务真实性由执行者核验"
            },
            "minItems": 1,
            "description": "支持判断的来源、实际观察和验证证据。"
          },
          "next_action": {
            "type": "string",
            "pattern": "\\S",
            "description": "根据用户决定记录的后续安排。"
          }
        },
        "required": [
          "decision",
          "evidence",
          "next_action"
        ],
        "additionalProperties": true,
        "description": "结构化记录"
      }
    }
  },
  "title": "学习继续决策",
  "description": "练习达到轮次上限时等待明确决定，记录后续学习安排。"
}
