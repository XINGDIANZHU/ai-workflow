{
  "id": "experience.extract",
  "version": "2",
  "kind": "agent",
  "outcomes": [
    "value",
    "no_value"
  ],
  "required_inputs": [
    "item_id",
    "owner"
  ],
  "cost": 0,
  "bounded_cost": false,
  "instruction": "处理输入指定的一个真实经验待办。先通过工作流入口读取权威账本；原条目已结案且当前明确要求基于新反馈再次维护时，先用稳定 reopen_id、author 和具体 reason 显式调用 backlog reopen，恢复原条目待领取；没有重新处理依据或授权时 waiting，不因读取或补充记录自动重开。然后以 input.owner 领取 input.item_id；已有其他处理者时等待，不另建副本或改名重领。读取条目 source、全部 updates（补充证据、纠正和复用反馈）与 reopenings 中的历史结案，根据来源运行、原始证据及 input.rules 核对事实，区分观察、原因解释和可复用方法。值得维护则返回 value，输出 candidate（依据、适用/不适用范围、最小维护目标、验证办法、现有能力入口）和 claim 回执；领取保持到后继结案。无价值或不适用时，先以明确理由通过 backlog close 结案并核对回执，再返回 no_value，输出 reason 与 closed_receipt。缺证据/权限/工具则报告 waiting；停止处理时释放原领取并保留已有证据。不要为通过流程编造规律或新建 Skill，不改原任务完成状态。\ncandidate 必须使用 io_contract 中的具名字段：evidence、scope、exclusions、maintenance_goal、validation、existing_entry；没有既有入口则 existing_entry=null。",
  "io_contract": {
    "version": "1",
    "input": {
      "type": "object",
      "properties": {
        "item_id": {
          "type": "string",
          "pattern": "\\S",
          "description": "经验待办的稳定编号。"
        },
        "owner": {
          "type": "string",
          "pattern": "\\S",
          "description": "本次待办处理者的身份。"
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "pattern": "\\S",
                "description": "非空文字说明或标识"
              },
              "sha256": {
                "type": "string",
                "pattern": "\\S",
                "description": "非空文字说明或标识"
              },
              "status": {
                "type": "string",
                "pattern": "\\S",
                "description": "非空文字说明或标识"
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": true,
            "description": "结构化记录"
          },
          "minItems": 0,
          "description": "需核对并读取的规则文件及内容哈希"
        }
      },
      "required": [
        "item_id",
        "owner"
      ],
      "additionalProperties": false,
      "description": "本节点的局部输入；不读取其他节点的隐含状态"
    },
    "outputs": {
      "value": {
        "type": "object",
        "properties": {
          "candidate": {
            "type": "object",
            "properties": {
              "evidence": {
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "\\S",
                      "description": "非空文字说明或标识"
                    },
                    {
                      "type": "object",
                      "properties": {},
                      "required": [],
                      "additionalProperties": true,
                      "description": "结构化记录",
                      "minProperties": 1
                    }
                  ],
                  "description": "文字说明或具名的结构化内容；其业务真实性由执行者核验"
                },
                "minItems": 1,
                "description": "依据、来源与实际观察；可用文字说明或具名记录"
              },
              "scope": {
                "type": "string",
                "pattern": "\\S",
                "description": "非空文字说明或标识"
              },
              "exclusions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "\\S",
                  "description": "非空文字说明或标识"
                },
                "minItems": 0,
                "description": "有序条目"
              },
              "maintenance_goal": {
                "type": "string",
                "pattern": "\\S",
                "description": "非空文字说明或标识"
              },
              "validation": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "\\S",
                    "description": "可观察的验收条件"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "\\S",
                      "description": "非空文字说明或标识"
                    },
                    "minItems": 1,
                    "description": "有序条目"
                  }
                ],
                "description": "验收条件文字或非空条件列表"
              },
              "existing_entry": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "\\S",
                    "description": "非空文字说明或标识"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "evidence",
              "scope",
              "exclusions",
              "maintenance_goal",
              "validation",
              "existing_entry"
            ],
            "additionalProperties": true,
            "description": "待验证、待保存的候选经验及成立条件。"
          },
          "claim": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": true,
            "description": "待办领取回执，用于确认当前处理身份。",
            "minProperties": 1
          }
        },
        "required": [
          "candidate",
          "claim"
        ],
        "additionalProperties": true,
        "description": "结构化记录"
      },
      "no_value": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "pattern": "\\S",
            "description": "作出本分支判断的原因及必要说明。"
          },
          "closed_receipt": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": true,
            "description": "经验待办的结案回执。",
            "minProperties": 1
          }
        },
        "required": [
          "reason",
          "closed_receipt"
        ],
        "additionalProperties": true,
        "description": "结构化记录"
      }
    }
  },
  "title": "提炼经验",
  "description": "从真实任务的沉淀待办提炼可复用经验；无价值项带依据结案。"
}
