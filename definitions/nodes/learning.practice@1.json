{
  "id": "learning.practice",
  "version": "1",
  "kind": "agent",
  "outcomes": [
    "success"
  ],
  "required_inputs": [
    "lesson"
  ],
  "cost": 0,
  "bounded_cost": false,
  "instruction": "执行 本节点规定的职责，仅使用交付的局部输入和当前授权；不猜测前驱节点名称或全局最新文件。若 input.rules 存在，核对文件实际 SHA256 并读取本次必要规则；恢复时补读缺失内容。明确区分事实、假设、结果与未验证范围。需要用户意图、权限或改变判断的证据时发送 kind=waiting，说明问题、来源、答复映射和恢复条件，不能用 completed 结束未解决事项。必要成果保存为真实文件并返回绝对路径、类型、版本或内容标识；完成实际职责后才报告 success。收到 reply 后沿原 execution_id/attempt 接续，不复制执行。只读查询自身运行/账本以核对授权、预算、在途状态和已认领待办；不直接修改运行状态或派发后继。可将有依据且不阻塞当前验收的发现放入 discoveries，不强造经验或 Skill。默认会话内执行；后台唤起未提供。\n把题目交给用户，以 kind=waiting 保存问题与答复映射，不编造用户回答。收到 reply 后保留原答案及题目，输出 answer、question、artifacts。失败反馈用于调整练习与讲解，不替用户作答。",
  "io_contract": {
    "version": "1",
    "input": {
      "type": "object",
      "properties": {
        "lesson": {
          "type": "object",
          "properties": {
            "lesson": {
              "type": "string",
              "pattern": "\\S",
              "description": "非空文字说明或标识"
            },
            "question": {
              "type": "string",
              "pattern": "\\S",
              "description": "非空文字说明或标识"
            },
            "expected_evidence": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "\\S",
                  "description": "可观察的验收条件"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "\\S",
                    "description": "非空文字说明或标识"
                  },
                  "minItems": 1,
                  "description": "有序条目"
                }
              ],
              "description": "验收条件文字或非空条件列表"
            }
          },
          "required": [
            "lesson",
            "question",
            "expected_evidence"
          ],
          "additionalProperties": true,
          "description": "讲解内容，或包含讲解与练习的学习包。"
        },
        "feedback": {
          "anyOf": [
            {
              "type": "object",
              "properties": {},
              "required": [],
              "additionalProperties": true,
              "description": "结构化记录",
              "minProperties": 1
            },
            {
              "type": "null"
            }
          ],
          "description": "上一轮练习或审阅的反馈。"
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "pattern": "\\S",
                "description": "非空文字说明或标识"
              },
              "sha256": {
                "type": "string",
                "pattern": "\\S",
                "description": "非空文字说明或标识"
              },
              "status": {
                "type": "string",
                "pattern": "\\S",
                "description": "非空文字说明或标识"
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": true,
            "description": "结构化记录"
          },
          "minItems": 0,
          "description": "需核对并读取的规则文件及内容哈希"
        }
      },
      "required": [
        "lesson"
      ],
      "additionalProperties": false,
      "description": "本节点的局部输入；不读取其他节点的隐含状态"
    },
    "outputs": {
      "success": {
        "type": "object",
        "properties": {
          "answer": {
            "type": "string",
            "pattern": "\\S",
            "description": "学习者的真实回答。"
          },
          "question": {
            "type": "string",
            "pattern": "\\S",
            "description": "交给学习者回答的练习问题。"
          },
          "artifacts": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "\\S",
                "description": "成果路径或结构化答案的文字"
              },
              {
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "\\S",
                      "description": "非空文字说明或标识"
                    },
                    {
                      "type": "object",
                      "properties": {},
                      "required": [],
                      "additionalProperties": true,
                      "description": "结构化记录",
                      "minProperties": 1
                    }
                  ],
                  "description": "文字说明或具名的结构化内容；其业务真实性由执行者核验"
                },
                "minItems": 1,
                "description": "有序条目"
              },
              {
                "type": "object",
                "properties": {},
                "required": [],
                "additionalProperties": true,
                "description": "结构化记录",
                "minProperties": 1
              }
            ],
            "description": "本次需要处理或交接的实际成果、文件引用或具名成果包。"
          }
        },
        "required": [
          "answer",
          "question",
          "artifacts"
        ],
        "additionalProperties": true,
        "description": "结构化记录"
      }
    }
  },
  "title": "练习与作答",
  "description": "收集学习者的真实回答；缺少回答时等待，按反馈组织后续练习。"
}
