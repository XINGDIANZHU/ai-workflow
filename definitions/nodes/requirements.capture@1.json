{
  "id": "requirements.capture",
  "version": "1",
  "kind": "agent",
  "outcomes": [
    "success"
  ],
  "required_inputs": [
    "request"
  ],
  "cost": 0,
  "bounded_cost": false,
  "instruction": "执行 本节点规定的职责，仅使用交付的局部输入和当前授权；不猜测前驱节点名称或全局最新文件。若 input.rules 存在，核对文件实际 SHA256 并读取本次必要规则；恢复时补读缺失内容。明确区分事实、假设、结果与未验证范围。需要用户意图、权限或改变判断的证据时发送 kind=waiting，说明问题、来源、答复映射和恢复条件，不能用 completed 结束未解决事项。必要成果保存为真实文件并返回绝对路径、类型、版本或内容标识；完成实际职责后才报告 success。收到 reply 后沿原 execution_id/attempt 接续，不复制执行。只读查询自身运行/账本以核对授权、预算、在途状态和已认领待办；不直接修改运行状态或派发后继。可将有依据且不阻塞当前验收的发现放入 discoveries，不强造经验或 Skill。默认会话内执行；后台唤起未提供。\n接收并保留原始需求、来源、授权与启用依据；确认这是明确启用的任务。输出 request、source、authorization。",
  "io_contract": {
    "version": "1",
    "input": {
      "type": "object",
      "properties": {
        "request": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "\\S",
              "description": "非空文字说明或标识"
            },
            {
              "type": "object",
              "properties": {},
              "required": [],
              "additionalProperties": true,
              "description": "结构化记录",
              "minProperties": 1
            }
          ],
          "description": "用户的原始需求；可以是文字或具名需求记录。"
        },
        "source": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "\\S",
                  "description": "非空文字说明或标识"
                },
                {
                  "type": "object",
                  "properties": {},
                  "required": [],
                  "additionalProperties": true,
                  "description": "结构化记录",
                  "minProperties": 1
                }
              ],
              "description": "文字说明或具名的结构化内容；其业务真实性由执行者核验"
            },
            {
              "type": "null"
            }
          ],
          "description": "需求的来源，例如用户输入或引用材料；没有时可省略。"
        },
        "authorization": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "\\S",
                  "description": "非空文字说明或标识"
                },
                {
                  "type": "object",
                  "properties": {},
                  "required": [],
                  "additionalProperties": true,
                  "description": "结构化记录",
                  "minProperties": 1
                }
              ],
              "description": "文字说明或具名的结构化内容；其业务真实性由执行者核验"
            },
            {
              "type": "null"
            }
          ],
          "description": "本次任务获准执行的范围、权限或用户约定。"
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "pattern": "\\S",
                "description": "非空文字说明或标识"
              },
              "sha256": {
                "type": "string",
                "pattern": "\\S",
                "description": "非空文字说明或标识"
              },
              "status": {
                "type": "string",
                "pattern": "\\S",
                "description": "非空文字说明或标识"
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": true,
            "description": "结构化记录"
          },
          "minItems": 0,
          "description": "需核对并读取的规则文件及内容哈希"
        }
      },
      "required": [
        "request"
      ],
      "additionalProperties": false,
      "description": "本节点的局部输入；不读取其他节点的隐含状态"
    },
    "outputs": {
      "success": {
        "type": "object",
        "properties": {
          "request": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "\\S",
                "description": "非空文字说明或标识"
              },
              {
                "type": "object",
                "properties": {},
                "required": [],
                "additionalProperties": true,
                "description": "结构化记录",
                "minProperties": 1
              }
            ],
            "description": "用户的原始需求；可以是文字或具名需求记录。"
          }
        },
        "required": [
          "request"
        ],
        "additionalProperties": true,
        "description": "原始需求与授权信息的交接记录"
      }
    }
  },
  "title": "接收需求",
  "description": "接收原始需求，保留来源和授权，明确任务目标。"
}
