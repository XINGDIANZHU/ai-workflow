{
  "id": "learning-mini",
  "version": "2",
  "description": "小型讲解—人工答题—审阅—有界再练习。等待不调用模型；修正练习最多三轮后进入明确待决节点。",
  "nodes": {
    "lesson": {
      "node": "learning.explain@1",
      "input": {
        "topic": {
          "$ref": "input.topic"
        },
        "criteria": {
          "$ref": "input.criteria"
        }
      }
    },
    "practice": {
      "node": "learning.practice@1",
      "depends": [
        "lesson"
      ],
      "input": {
        "lesson": {
          "$ref": "steps.lesson.output"
        },
        "feedback": {
          "$ref": "vars.feedback",
          "default": null
        }
      }
    },
    "review": {
      "node": "artifact.review@2",
      "depends": [
        "practice"
      ],
      "input": {
        "artifacts": {
          "$ref": "steps.practice.output"
        },
        "criteria": {
          "$ref": "input.criteria"
        }
      },
      "routes": {
        "repair": {
          "reset": [
            "practice"
          ],
          "set": {
            "feedback": {
              "$ref": "steps.review.output"
            }
          },
          "max_rounds": 3,
          "on_limit": {
            "reset": [
              "decision"
            ],
            "set": {
              "feedback": {
                "$ref": "steps.review.output"
              }
            }
          }
        },
        "replan": {
          "reset": [
            "decision"
          ],
          "set": {
            "feedback": {
              "$ref": "steps.review.output"
            }
          },
          "max_rounds": 3,
          "on_limit": {
            "reset": [
              "decision"
            ],
            "set": {
              "feedback": {
                "$ref": "steps.review.output"
              }
            }
          }
        }
      }
    },
    "decision": {
      "node": "learning.decide@1",
      "depends": [
        "review"
      ],
      "when": {
        "review": [
          "repair",
          "replan"
        ]
      },
      "input": {
        "feedback": {
          "$ref": "vars.feedback"
        },
        "topic": {
          "$ref": "input.topic"
        }
      }
    }
  }
}
